#cloud-config
autoinstall:
  version: 1
  locale: en_US
  keyboard:
    layout: us 
  early-commands:
    # Disable unattended-upgrades
    - ( FILE="/target/usr/bin/unattended-upgrade" ; until [ -e "$FILE" ] ; do sleep 1 ; done ; sed -i '1i#!/bin/true' "$FILE" ) &
  late-commands:
    # Re-enable unattended-upgrades
    - sed -i '\,^#!/bin/true$,d' "/target/usr/bin/unattended-upgrade"
    # Upgrade packages
    - curtin in-target -- apt-get update
    - curtin in-target -- apt-get --yes upgrade
  ssh:
    install-server: true
    allow-pw: false 
    disable_root: true
    ssh_quiet_keygen: true
    allow_public_ssh_keys: true
  packages:
    - qemu-guest-agent
    - sudo
  storage:
    layout:
      name: direct
    swap:
      size: 0
  user-data:
    timezone: Europe/Amsterdam
    package_upgrade: false
    users:
      - name: adama 
        groups: [admin, sudo]
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
        ssh_authorized_keys:
          - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKmNRNxNaPPOAy8dkouVvMDx1vFMolgeoynsEdWixWKs adama@fedora
      - name: server
        sudo: false
        shell: /bin/bash
        ssh_authorized_keys:
          - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKmNRNxNaPPOAy8dkouVvMDx1vFMolgeoynsEdWixWKs adama@fedora
